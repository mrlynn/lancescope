# corpus + derived data — never commit (see README on rights)
data/
.venv/
__pycache__/
*.pyc
.env
.DS_Store

# web
web/node_modules/
web/.next/
web/out/

# Desktop build outputs. The sidecar is 428 MB and the static export is derived
# from the source beside it; both are rebuilt by `make sidecar`.
packaging/dist/
packaging/build/
web/out/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Credentials, wherever somebody puts them. An app-specific password in the working
# tree is one `git add -A` away from being in a public repository forever, and the
# person who wrote the file is not the person who will run that command.
.cred
.cred.*
.env
.env.*
*.p8
*.p12
