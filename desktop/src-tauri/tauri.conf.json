{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanceScope",
  "version": "0.1.0",
  "identifier": "com.lancescope.workbench",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Understand a LanceDB database",
    "longDescription": "A read-only workbench for LanceDB: schema, versions, indices, fragments and rows, with the byte cost of every read shown as you go.",
    "resources": {
      "../../packaging/dist/lancescope-server": "server"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 205
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 205
        }
      }
    }
  }
}
